{
 "id": "markgogo.dev:genui/v3",
 "version": "1",
 "language": "openui-lang/1.0",
 "root": "Col",
 "schema": {
  "$defs": {
   "Col": {
    "type": "object",
    "description": "Stacks children vertically",
    "properties": {
     "children": {
      "type": "array"
     },
     "gap": {
      "type": "number"
     },
     "align": {
      "type": "string",
      "enum": [
       "start",
       "center",
       "end",
       "stretch",
       "baseline"
      ]
     }
    },
    "required": [
     "children"
    ]
   },
   "Row": {
    "type": "object",
    "description": "Lays children out horizontally",
    "properties": {
     "children": {
      "type": "array"
     },
     "gap": {
      "type": "number"
     },
     "align": {
      "type": "string",
      "enum": [
       "start",
       "center",
       "end",
       "stretch",
       "baseline"
      ]
     },
     "justify": {
      "type": "string",
      "enum": [
       "start",
       "center",
       "end",
       "between",
       "around",
       "evenly"
      ]
     },
     "wrap": {
      "type": "boolean"
     }
    },
    "required": [
     "children"
    ]
   },
   "Box": {
    "type": "object",
    "description": "A styled container",
    "properties": {
     "children": {
      "type": "array"
     },
     "direction": {
      "type": "string",
      "enum": [
       "row",
       "col"
      ]
     },
     "gap": {
      "type": "number"
     },
     "padding": {
      "type": "number"
     },
     "background": {
      "type": "string"
     },
     "radius": {},
     "border": {
      "type": "boolean"
     },
     "width": {},
     "height": {},
     "flex": {
      "type": "number"
     },
     "align": {
      "type": "string",
      "enum": [
       "start",
       "center",
       "end",
       "stretch",
       "baseline"
      ]
     },
     "justify": {
      "type": "string",
      "enum": [
       "start",
       "center",
       "end",
       "between",
       "around",
       "evenly"
      ]
     },
     "wrap": {
      "type": "boolean"
     }
    },
    "required": []
   },
   "Grid": {
    "type": "object",
    "description": "Lays children out in equal columns",
    "properties": {
     "children": {
      "type": "array"
     },
     "columns": {
      "type": "number"
     },
     "minChildWidth": {
      "type": "number"
     },
     "gap": {
      "type": "number"
     }
    },
    "required": [
     "children"
    ]
   },
   "Card": {
    "type": "object",
    "description": "A framed group",
    "properties": {
     "children": {
      "type": "array"
     },
     "variant": {
      "type": "string",
      "enum": [
       "outline",
       "soft"
      ]
     },
     "gap": {
      "type": "number"
     },
     "padding": {
      "type": "number"
     }
    },
    "required": [
     "children"
    ]
   },
   "Divider": {
    "type": "object",
    "description": "A thin line",
    "properties": {},
    "required": []
   },
   "Spacer": {
    "type": "object",
    "description": "Takes the free space of its row or column",
    "properties": {},
    "required": []
   },
   "Title": {
    "type": "object",
    "description": "A heading",
    "properties": {
     "text": {
      "type": "string"
     },
     "size": {
      "type": "string",
      "enum": [
       "sm",
       "md",
       "lg",
       "xl",
       "2xl",
       "3xl"
      ]
     },
     "color": {
      "type": "string"
     }
    },
    "required": [
     "text"
    ]
   },
   "Text": {
    "type": "object",
    "description": "Body text, or a run of strings and inline components",
    "properties": {
     "text": {},
     "size": {
      "type": "string",
      "enum": [
       "xs",
       "sm",
       "md",
       "lg"
      ]
     },
     "color": {
      "type": "string"
     },
     "weight": {
      "type": "string",
      "enum": [
       "normal",
       "medium",
       "semibold"
      ]
     },
     "italic": {
      "type": "boolean"
     },
     "lineThrough": {
      "type": "boolean"
     },
     "tabularNums": {
      "type": "boolean"
     },
     "maxLines": {
      "type": "number"
     }
    },
    "required": [
     "text"
    ]
   },
   "Caption": {
    "type": "object",
    "description": "Small secondary text",
    "properties": {
     "text": {
      "type": "string"
     },
     "color": {
      "type": "string"
     }
    },
    "required": [
     "text"
    ]
   },
   "Label": {
    "type": "object",
    "description": "A small label above a value",
    "properties": {
     "text": {
      "type": "string"
     }
    },
    "required": [
     "text"
    ]
   },
   "Badge": {
    "type": "object",
    "description": "A short status in a pill",
    "properties": {
     "text": {
      "type": "string"
     },
     "color": {
      "type": "string",
      "enum": [
       "neutral",
       "info",
       "success",
       "warning",
       "danger",
       "purple",
       "pink"
      ]
     },
     "icon": {
      "type": "string"
     }
    },
    "required": [
     "text"
    ]
   },
   "Link": {
    "type": "object",
    "description": "Text that opens a web address",
    "properties": {
     "text": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "text",
     "url"
    ]
   },
   "ListItem": {
    "type": "object",
    "description": "A list entry with a title",
    "properties": {
     "title": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "marker": {
      "type": "string"
     },
     "children": {
      "type": "array"
     }
    },
    "required": [
     "title"
    ]
   },
   "List": {
    "type": "object",
    "description": "A bulleted, numbered or timeline list",
    "properties": {
     "items": {
      "type": "array"
     },
     "marker": {
      "type": "string",
      "enum": [
       "bullet",
       "number",
       "none"
      ]
     },
     "timeline": {
      "type": "boolean"
     }
    },
    "required": [
     "items"
    ]
   },
   "Markdown": {
    "type": "object",
    "description": "Markdown prose",
    "properties": {
     "text": {
      "type": "string"
     }
    },
    "required": [
     "text"
    ]
   },
   "Quote": {
    "type": "object",
    "description": "A quotation",
    "properties": {
     "text": {
      "type": "string"
     },
     "cite": {
      "type": "string"
     }
    },
    "required": [
     "text"
    ]
   },
   "Code": {
    "type": "object",
    "description": "A code block",
    "properties": {
     "code": {
      "type": "string"
     },
     "language": {
      "type": "string"
     }
    },
    "required": [
     "code"
    ]
   },
   "Source": {
    "type": "object",
    "description": "Attributes its children to sections of the original document",
    "properties": {
     "sources": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "children": {
      "type": "array"
     }
    },
    "required": [
     "sources",
     "children"
    ]
   }
  }
 }
}