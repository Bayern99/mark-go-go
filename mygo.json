{
  "name": "Mark Go Go",
  "slug": "mark-go-go",
  "identifier": "dev.markgogo.editor",
  "version": "0.6.5-rc.1",
  "icon": "resources/icon.png",
  "buildCommand": "go run ./scripts/bundle-cli",
  "resources": ["third_party/mygo/LICENSE"],
  "linux": { "webview": false },
  "out": "build",
  "fileAssociations": [
    {
      "ext": [
        "md",
        "markdown"
      ],
      "name": "Markdown Document",
      "mimeType": "text/markdown"
    }
  ]
}
